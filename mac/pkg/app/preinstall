#!/bin/bash
# Avant l'installation : ferme Layers Keys s'il est ouvert, puis retire proprement l'ancienne version.
# Les réglages, sons et presets (dans ~/Library/Application Support/LayersKeys) ne sont jamais touchés.
pkill -TERM -x LayersKeys 2>/dev/null
for i in 1 2 3 4 5 6; do pgrep -x LayersKeys >/dev/null || break; sleep 0.5; done
pkill -KILL -x LayersKeys 2>/dev/null
rm -rf "/Applications/Layers Keys.app" "/Applications/Désinstaller Layers Keys.app"
exit 0
