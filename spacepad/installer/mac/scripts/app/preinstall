#!/bin/bash
# Avant l'installation : ferme Spacepad s'il est ouvert, puis retire l'ancienne version.
# La liste des librairies (/Library/Application Support/JB Praise/Spacepad) et les sons ne sont jamais touchés.
pkill -TERM -x Spacepad 2>/dev/null
for i in 1 2 3 4 5 6; do pgrep -x Spacepad >/dev/null || break; sleep 0.5; done
pkill -KILL -x Spacepad 2>/dev/null
rm -rf "/Applications/Spacepad.app" "/Applications/Désinstaller Spacepad.app"
exit 0
